{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "repository_path",
    "baseline_ref",
    "baseline_bundle_path",
    "output_root",
    "security_changes_only",
    "human_review_stage",
    "limits",
    "change_policy",
    "candidate_bundle_gate_id",
    "default_retest_gate_ids",
    "environment_allowlist",
    "agent",
    "gates",
    "finding_overrides"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "repository_path": {"type": "string", "minLength": 1},
    "baseline_ref": {"type": "string", "minLength": 1},
    "baseline_bundle_path": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "security_changes_only": {"const": true},
    "human_review_stage": {"const": "final"},
    "candidate_bundle_gate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
    "default_retest_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"}
    },
    "environment_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "executable_sha256", "timeout_seconds", "auto_commit"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "executable_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "auto_commit": {"const": true},
        "generation": {"$ref": "#/$defs/generation"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts_per_ticket", "max_total_attempts"],
      "properties": {
        "max_attempts_per_ticket": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_total_attempts": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "change_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_allowed_paths",
        "test_paths",
        "protected_paths",
        "max_files_changed",
        "max_changed_lines",
        "allow_dependency_changes",
        "allow_binary_changes"
      ],
      "properties": {
        "default_allowed_paths": {"$ref": "#/$defs/pathPatterns"},
        "test_paths": {"$ref": "#/$defs/pathPatterns"},
        "protected_paths": {"$ref": "#/$defs/pathPatterns"},
        "max_files_changed": {"type": "integer", "minimum": 1, "maximum": 200},
        "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 20000},
        "allow_dependency_changes": {"type": "boolean"},
        "allow_binary_changes": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/gate"}
    },
    "finding_overrides": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/findingOverride"}
    }
  },
  "$defs": {
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "endpoint", "provider", "model", "reasoning_effort", "api_key_env", "source_transfer_approved", "context_files", "max_context_bytes", "max_response_bytes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string", "maxLength": 2000},
        "provider": {"type": "string", "maxLength": 128},
        "model": {"type": "string", "maxLength": 128},
        "reasoning_effort": {"type": "string", "maxLength": 128},
        "api_key_env": {"type": "string", "maxLength": 100},
        "source_transfer_approved": {"type": "boolean"},
        "context_files": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "max_context_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 2097152}
      }
    },
    "pathPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "command", "executable_sha256", "timeout_seconds", "required", "working_directory", "artifact_paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "class": {"enum": ["quality", "security", "retest", "smoke"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "executable_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "required": {"type": "boolean"},
        "working_directory": {"type": "string", "maxLength": 300},
        "artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "findingOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_fingerprint",
        "requires_code_change",
        "allowed_paths",
        "depends_on_fingerprints",
        "retest_gate_ids",
        "allow_dependency_changes",
        "priority"
      ],
      "properties": {
        "finding_fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "requires_code_change": {"type": "boolean"},
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "depends_on_fingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        },
        "retest_gate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"}
        },
        "allow_dependency_changes": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    }
  }
}
