{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "domain", "base_url", "output_root", "max_requests", "requests_per_second", "max_download_bytes", "policies", "hibp_api_key_env", "hibp_user_agent", "public_contact_paths"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "domain": {"type": "string", "minLength": 3},
    "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "cors_origin": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "application_category": {"enum": ["baas", "web-application", "custom-backend", "static", "unknown"]},
    "lead_origin": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "output_root": {"type": "string"},
    "max_requests": {"type": "integer", "minimum": 1, "maximum": 500},
    "requests_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
    "max_download_bytes": {"type": "integer", "minimum": 1, "maximum": 20971520},
    "tool_lock_path": {"type": "string", "minLength": 1},
    "policies": {"$ref": "#/$defs/policies"},
    "hibp_api_key_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "hibp_user_agent": {"type": "string", "minLength": 3},
    "public_contact_paths": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/[^/]"}
    }
  },
  "$defs": {
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["engagement", "tool", "matrix"],
      "properties": {
        "engagement": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "matrix": {"type": "string"}
      }
    }
  }
}
